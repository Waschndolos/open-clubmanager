{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open ClubManager",
  "version": "1.0.0",
  "identifier": "org.clubmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev:browser",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open ClubManager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/open-clubmanager-server"
    ]
  }
}
